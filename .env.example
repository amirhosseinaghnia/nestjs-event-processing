# =========================
# Process service
# =========================
PORT=3000
MONGODB_URI=mongodb://mongo:27017/process
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_PREFETCH=10
LOG_LEVEL=log

# =========================
# Agent service
# =========================
AGENT_ID=agent-1
# Reuse RABBITMQ_URL / LOG_LEVEL above
EVENT_RATE_PER_SEC=5

# =========================
# Local (non-Docker) defaults
# =========================
# MONGODB_URI=mongodb://127.0.0.1:27017/process
# REDIS_URL=redis://127.0.0.1:6379
# RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
